// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
enum Role {
  USER
  ADMIN
}
model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String
  avatarUrl    String?
  age          Int?
  password     String?
  googleId     String?      @unique
  authProvider AuthProvider @default(LOCAL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  role  String @default("USER")
  nativeLanguage String @default("vi")

  progress UserProgress[]
  stats    UserStats?
  decks    Deck[]
  studyLogs StudyLog[]
  dictionaryHistory DictionaryHistory[]
  favoriteWords FavoriteWord[]
  chatMessages ChatMessage[]
  quests   UserQuest[]
  hskExamResults HskExamResult[]
  savedParagraphs SavedParagraph[]
  skillLogs UserSkillLog[]
  grammarProgress UserGrammarProgress[]
  gameRecords GameRecord[]
  weakWords UserWeakWord[]
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model UserStats {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  currentStreak         Int       @default(0)
  longestStreak         Int       @default(0)
  dailyTarget           Int       @default(20)
  lastStudyDate         DateTime?
  xp                    Int       @default(0)
  coins                 Int       @default(0)
  lastGardenHarvestDate DateTime?
  streakFreezeCount     Int       @default(0)
  xpBoostCount          Int       @default(0)
  xpBoostUntil          DateTime?
  water                 Int       @default(35)
  fertilizer            Int       @default(55)
  harvestPoints         Int       @default(170)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deck {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  isSystem    Boolean  @default(false)
  isPublic    Boolean  @default(false)
  shareCode   String?  @unique
  createdAt   DateTime @default(now())
  language    String   @default("ZH")

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  flashcards Flashcard[]
  savedParagraphs SavedParagraph[]
}

model Flashcard {
  id Int @id @default(autoincrement())

  deckId Int

  hanzi          String
  pinyin         String
  meaning        String
  radicals       String?
  strokeData     String?
  audioUrl       String?
  exampleHanzi   String?
  examplePinyin  String?
  exampleMeaning String?
  topicId        Int?

  deck       Deck           @relation(fields: [deckId], references: [id])
  progresses UserProgress[]
  studyLogs  StudyLog[]

  @@unique([deckId, hanzi, meaning])
}

model UserProgress {
  id             Int      @id @default(autoincrement())
  userId         Int
  flashcardId    Int
  interval       Int      @default(0)
  easeFactor     Float    @default(2.5)
  repetitions    Int      @default(0)
  nextReviewDate DateTime @default(now())

  stability      Float    @default(0.0)
  difficulty     Float    @default(0.0)
  lapses         Int      @default(0)
  state          Int      @default(0)
  lastReview     DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
}

model StudyLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  cardId    Int
  rating    Int
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model DictionaryHistory {
  id            Int      @id @default(autoincrement())
  userId        Int
  hanzi         String
  pinyin        String?
  sv            String?
  vi            String?
  aiExplanation String?  @db.Text
  aiGeneratedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hanzi])
}

model FavoriteWord {
  id             Int      @id @default(autoincrement())
  userId         Int
  hanzi          String
  pinyin         String?
  sv             String?
  vi             String?
  exampleHanzi   String?
  examplePinyin  String?
  exampleMeaning String?
  createdAt      DateTime @default(now()) 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, hanzi])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String   // "user" hoặc "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DictionaryWord {
  id  Int      @id @default(autoincrement())
  s   String   // Giản thể
  t   String?  // Phồn thể
  p   String?  // Pinyin
  pt  String?  // Pinyin số
  sp  String?  // Pinyin trơn
  b   Int?     // Số nét
  vi  String?  // Nghĩa tiếng Việt
  sv  String?  // Âm Hán Việt
  en  String[] // Mảng nghĩa tiếng Anh
  hsk Int?     // Cấp độ HSK
  topicId Int?

  @@index([s])
  @@index([sp])
  @@index([hsk])
  @@index([sv])
  @@index([p])
  @@index([pt])
}

model UserQuest {
  id          Int      @id @default(autoincrement())
  userId      Int
  questType   String   // "STUDY_CARDS", "AI_CHAT", "DICTIONARY_LOOKUP", "FAVORITE_WORD", "PLAY_GAME", "WRITE_PRACTICE", "SPEAK_PRACTICE"
  title       String
  description String?
  target      Int
  progress    Int      @default(0)
  xpReward    Int      @default(20)
  coinReward  Int      @default(10)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  dateStr     String   // YYYY-MM-DD local date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateStr])
}

model HskExamResult {
  id             Int      @id @default(autoincrement())
  userId         Int
  testId         String?  // Mã đề thi, ví dụ: "hsk1-1"
  hskLevel       Int      // Cấp độ HSK (1-6)
  examTitle      String   // Tên đề thi (ví dụ: "Đề mô phỏng HSK 1 - Bộ đề 01")
  score          Int      // Điểm đạt được
  maxScore       Int      // Tổng điểm (thường là 100 hoặc 300)
  correctAnswers Int      // Số câu đúng
  totalQuestions Int      // Tổng số câu hỏi
  duration       Int      // Thời gian làm bài (tính bằng giây)
  sectionScores  Json?    // Chi tiết điểm từng kỹ năng
  userAnswers    Json?    // Chi tiết câu trả lời của user
  completedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedParagraph {
  id        Int      @id @default(autoincrement())
  deckId    Int
  userId    Int
  hanzi     String   @db.Text
  pinyin    String   @db.Text
  meaning   String   @db.Text
  words     String[]
  wordUsage Json     // Store wordUsage details as JSON array
  createdAt DateTime @default(now())

  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deckId])
  @@index([userId])
}

model DictionaryExample {
  id             Int      @id @default(autoincrement())
  word           String?  // Từ vựng gốc được liên kết cụ thể (ví dụ: "行")
  pinyin         String?  // Phiên âm từ vựng gốc (ví dụ: "xíng")
  exampleHanzi   String   // Câu ví dụ gốc (Ví dụ: "司机, 停车...?")
  examplePinyin  String?  // Phiên âm câu ví dụ (cho Tiếng Trung)
  exampleMeaning String   // Nghĩa Tiếng Việt
  language       String   @default("ZH") // "ZH" hoặc "EN"
  createdAt      DateTime @default(now())

  @@index([word, pinyin])
  @@index([language])
}

// ═══════════════════════════════════════════
// Nhật ký Kỹ năng Tổng hợp
// Lưu kết quả: Ngữ pháp, Phát âm, Dịch câu, Viết chữ, Trắc nghiệm
// ═══════════════════════════════════════════
model UserSkillLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  skillType String   // "GRAMMAR" | "SPEAKING" | "TRANSLATION" | "WRITING" | "QUIZ" | "DICTATION"
  targetId  String?  // ID bài/câu/cấu trúc cụ thể
  level     String?  // "HSK 1" - "HSK 6"
  score     Int      // Điểm 0-100
  accuracy  Float?   // Tỷ lệ đúng 0.0-1.0
  details   Json?    // Chi tiết: câu trả lời, lỗi sai, transcript...
  duration  Int?     // Thời gian thực hiện (giây)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillType])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════
// Tiến độ Ngữ pháp (Mastery per Grammar Point)
// ═══════════════════════════════════════════
model UserGrammarProgress {
  id              Int      @id @default(autoincrement())
  userId          Int
  grammarId       String   // Khớp với id trong grammarData.js
  level           String   // "HSK 1" - "HSK 6"
  masteryScore    Int      @default(0) // 0-100%
  attempts        Int      @default(0)
  correctCount    Int      @default(0)
  lastPracticedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, grammarId])
}

// ═══════════════════════════════════════════
// Kỷ lục Game (Bảng điểm cao)
// ═══════════════════════════════════════════
model GameRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameType  String   // "FALLING_WORDS" | "MATCHING" | "UNSCRAMBLE"
  level     String?  // Cấp độ HSK hoặc ID bộ thẻ
  score     Int
  accuracy  Float?
  duration  Int?     // giây
  details   Json?    // missedWords, incorrectSentences...
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameType])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════
// Ngân hàng Từ vựng Yếu (Từ hay sai từ Game/Quiz)
// ═══════════════════════════════════════════
model UserWeakWord {
  id           Int      @id @default(autoincrement())
  userId       Int
  hanzi        String
  pinyin       String?
  meaning      String?
  source       String   // "FALLING_GAME" | "DICTATION" | "QUIZ" | "MATCHING" | "UNSCRAMBLE"
  mistakeCount Int      @default(1)
  lastMistakeAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hanzi])
}